rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /servers/{serverId} {
      allow read, write: if true;
    }

    match /projects/{projectId} {
      allow read, write: if true;
    }

    match /deployments/{deploymentId} {
      allow read, write: if true;
    }

    match /test/connection {
      allow read, write: if true;
    }
  }
}
